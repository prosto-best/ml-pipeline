FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/monitor.txt ./requirements/monitor.txt
RUN pip install --no-cache-dir -r requirements/monitor.txt

COPY src/ ./src/
# Модели и baseline-сэмплы для drift-проверки -- те же артефакты, что и в serve-образе
COPY artifacts/ ./artifacts/

ENV ARTIFACTS_DIR=/app/artifacts \
    PYTHONPATH=/app/src

ENTRYPOINT ["python", "src/monitor.py"]
